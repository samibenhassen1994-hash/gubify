            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'displayNameChangedAt', 'updatedAt'])
            && request.resource.data.displayName != resource.data.displayName
            && request.resource.data.displayNameChangedAt == request.time
            && request.resource.data.updatedAt == request.time
            && (
              !resource.data.keys().hasAny(['displayNameChangedAt'])
              || resource.data.displayNameChangedAt
                <= request.time - duration.value(30, 'd')
            )
          )
        );

      match /gubs/{id} {
        allow read: if own(uid);
        allow create: if own(uid) && validGubMemberAndCopy(id, uid,
          gubAfter(id).data.ownerId == uid ? 'owner' : 'member');
        allow update: if own(uid) && gubActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && validGubCopyRoleBackfill(request.resource.data, id, uid);
        allow delete: if own(uid) || gubDeletingOwner(id) || gubOwnerRemovingMember(id, uid);
      }
      match /communities/{id} {
        allow read: if linkedCommunityAccount()
          && (own(uid) || (isCommunityMember(id)
            && exists(communityMemberPath(id, uid))));
        allow create: if (linkedCommunityAccount() && own(uid) && (
            validCommunityMemberAndCopy(id, uid,
              communityAfter(id).data.ownerId == uid ? 'owner' : 'member')
            || validExistingCommunityCopy(id, uid)
          ))
          || (validCommunityApprovalSignal(id, uid)
            && validCommunityCopyData(request.resource.data, id, uid, 'member'));
        allow update: if (linkedCommunityAccount() && own(uid) && communityActive(id)
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
              && validCommunityCopyRoleBackfill(request.resource.data, id, uid))
            || validCommunityMemberAndCopy(id, uid, 'member')
          ))
          || (validCommunityApprovalSignal(id, uid)
            && validCommunityCopyData(request.resource.data, id, uid, 'member'));
        allow delete: if (linkedCommunityAccount() && own(uid)) || communityDeletingOwner(id)
          || communityOwnerRemovingMember(id, uid);
      }
      match /blockedUsers/{blockedUid} {
        allow get, list: if own(uid);
        allow create: if own(uid)
          && uid != blockedUid
          && request.resource.data.keys().hasOnly(['blockedUserId', 'blockedAt'])
          && request.resource.data.blockedUserId == blockedUid
          && request.resource.data.blockedAt == request.time;
        allow delete: if own(uid);
      }
    }

    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /inviteTokens/{canonicalCode} {
      allow get: if signedIn() && validInviteTokenCode(canonicalCode);
      allow list: if false;
      allow create: if !exists(inviteTokenPath(canonicalCode))
        && validInviteTokenCreate(canonicalCode);
      allow update: if validInviteTokenRevocation(canonicalCode)
        || validInviteTokenRegeneration(canonicalCode);
      allow delete: if gubDeletingOwner(resource.data.gubId)
        && resource.data.ownerId == request.auth.uid
        && resource.data.gubName == gubDoc(resource.data.gubId).data.name
        && gubDoc(resource.data.gubId).data.inviteTokenId == canonicalCode;
    }

    match /gubs/{id} {
      allow read: if (signedIn() && resource.data.ownerId == request.auth.uid)
        || isGubMember(id);
      allow create: if signedIn() && validGubRootCreate(id)
        && validGubOwnerMember(id, request.auth.uid)
        && validGubMemberAndCopy(id, request.auth.uid, 'owner');
      allow update: if (
        validInviteRegeneration(id)
        || (isGubOwner(id) && gubActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedBoardPostId'])
          && (request.resource.data.pinnedBoardPostId == null
            || (request.resource.data.pinnedBoardPostId is string
              && exists(/databases/$(database)/documents/gubs/$(id)/posts/$(request.resource.data.pinnedBoardPostId)))))
        || (signedIn() && gubActive(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && (request.resource.data.memberCount == resource.data.memberCount + 1
            || request.resource.data.memberCount == resource.data.memberCount - 1)
          && ((request.resource.data.memberCount == resource.data.memberCount + 1
              && validGubMemberAndCopy(id, request.auth.uid, 'member'))
            || (request.resource.data.memberCount == resource.data.memberCount - 1
              && (isGubOwner(id)
                || (request.auth.uid != resource.data.ownerId
                  && exists(gubMemberPath(id, request.auth.uid))
                  && !existsAfter(gubMemberPath(id, request.auth.uid)))))))
        || (isGubOwner(id) && resource.data.get('deletionStatus','active') == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deletionStatus','deletionRequestedBy','deletionStartedAt','deletionUpdatedAt','deletionPhase'
        ]) && request.resource.data.deletionStatus == 'deleting'
          && request.resource.data.deletionRequestedBy == request.auth.uid
          && request.resource.data.deletionStartedAt == request.time
          && request.resource.data.deletionUpdatedAt == request.time
          && request.resource.data.deletionPhase == 'preparing'
          && inviteTokenRevokedAfter(id, resource.data.inviteTokenId))
        || (gubDeletingOwner(id)
          && request.resource.data.deletionStatus == 'deleting'
          && request.resource.data.deletionRequestedBy == resource.data.deletionRequestedBy
          && request.resource.data.deletionStartedAt == resource.data.deletionStartedAt
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionPhase','deletionUpdatedAt','deletionMemberIds'])
          && validGubDeletionPhaseAdvance(resource.data.deletionPhase, request.resource.data.deletionPhase)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionUpdatedAt'])
            || request.resource.data.deletionUpdatedAt == request.time)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionMemberIds'])
            || request.resource.data.deletionMemberIds is list))
      );
      allow delete: if gubDeletingOwner(id)
        && !exists(inviteTokenPath(resource.data.inviteTokenId));

      match /members/{uid} {
        allow get: if own(uid) || isGubMember(id) || isGubOwner(id);
        allow list: if isGubMember(id) || isGubOwner(id);
        allow create: if own(uid) && gubAfter(id).data.get('deletionStatus','active') != 'deleting'
          && request.resource.data.role == (gubAfter(id).data.ownerId == uid ? 'owner' : 'member')
          && validGubMemberAndCopy(id, uid, request.resource.data.role);
        allow update: if own(uid) && gubActive(id)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['antiSpamRulesAccepted','antiSpamRulesAcceptedAt','antiSpamRulesVersion'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
              && validText(request.resource.data.displayName, 1, 25)
              && request.resource.data.displayName
                == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName));
        allow delete: if (isGubOwner(id) && uid != request.auth.uid)
          || (own(uid) && uid != gubDoc(id).data.ownerId
            && gubActive(id)
            && gubAfter(id).data.memberCount == gubDoc(id).data.memberCount - 1)
          || gubDeletingOwner(id);
      }
      match /bans/{uid} {
        allow get: if isGubOwner(id) || own(uid);
        allow list: if isGubOwner(id);
        allow create: if isGubOwner(id) && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['userId','displayName','photoUrl','bannedBy','bannedAt'])
          && request.resource.data.userId == uid
          && validText(request.resource.data.displayName, 1, 25)
          && validNullableString(request.resource.data.photoUrl)
          && request.resource.data.bannedBy == request.auth.uid
          && request.resource.data.bannedAt == request.time
          && !existsAfter(gubMemberPath(id, uid));
        allow delete: if isGubOwner(id);
      }
      match /messages/{messageId} {
        allow read: if gubDeletingOwner(id);
        allow read: if isGubMember(id)
          && resource.data.createdAt >= get(/databases/$(database)/documents/gubs/$(id)/members/$(request.auth.uid)).data.joinedAt;
        allow create: if isGubMember(id) && gubActive(id)
          && request.resource.data.keys().hasOnly(['messageId','gubId','senderId','senderName','text','createdAt'])
          && request.resource.data.messageId == messageId
          && request.resource.data.gubId == id
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == get(gubMemberPath(id, request.auth.uid)).data.displayName
          && request.resource.data.text is string
          && request.resource.data.createdAt is timestamp;
        allow update: if isGubMember(id) && gubActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderId','senderName'])
          && validIdentityAnonymization(resource.data.senderId, resource.data.senderName,
            request.resource.data.senderId, request.resource.data.senderName);
        allow delete: if gubDeletingOwner(id);
      }
      match /chatReads/{uid} {
        allow read: if (own(uid) && isGubMember(id)) || gubDeletingOwner(id);
        allow create, update: if own(uid) && isGubMember(id) && gubActive(id)
          && request.resource.data.keys().hasOnly(['userId','gubId','lastReadAt'])
          && request.resource.data.userId == uid
          && request.resource.data.gubId == id
          && request.resource.data.lastReadAt is timestamp;
        allow delete: if (own(uid) && isGubMember(id) && gubActive(id))
          || gubDeletingOwner(id);
      }
      match /boardReads/{uid} {
        allow read: if (own(uid) && isGubMember(id)) || gubDeletingOwner(id);
        allow create, update: if own(uid) && isGubMember(id) && gubActive(id)
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp;
        allow delete: if (own(uid) && isGubMember(id) && gubActive(id))
          || gubDeletingOwner(id);
      }
      match /posts/{postId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id)
          && request.resource.data.keys().hasOnly([
            'gubId','authorId','authorName','authorPhoto','message','likes','comments','createdAt','updatedAt'
          ])
          && request.resource.data.gubId == id
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && (request.resource.data.authorPhoto == null || request.resource.data.authorPhoto is string)
          && request.resource.data.message is string
          && request.resource.data.likes == 0
          && request.resource.data.comments == 0
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isGubMember(id) && gubActive(id)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorId','authorName','authorPhoto'])
              && validIdentityAnonymization(resource.data.authorId, resource.data.authorName,
                request.resource.data.authorId, request.resource.data.authorName)
              && request.resource.data.authorPhoto == null)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'comments','updatedAt','lastCommentAuthorId','lastCommentId'
              ])
              && request.resource.data.comments == resource.data.comments + 1
              && request.resource.data.updatedAt == request.time
              && request.resource.data.lastCommentAuthorId == request.auth.uid
              && request.resource.data.lastCommentId is string
              && getAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)/comments/$(request.resource.data.lastCommentId)).data.authorId == request.auth.uid)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && ((request.resource.data.likes == resource.data.likes + 1
                    && existsAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)/likes/$(request.auth.uid))
                    && !exists(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)/likes/$(request.auth.uid)))
                || (request.resource.data.likes == resource.data.likes - 1
                    && request.resource.data.likes >= 0
                    && exists(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)/likes/$(request.auth.uid))
                    && !existsAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)/likes/$(request.auth.uid))))));
        allow delete: if gubDeletingOwner(id);

        match /comments/{commentId} {
          allow read: if gubDeletingOwner(id);
          allow read: if isGubMember(id)
            && resource.data.createdAt >= get(gubMemberPath(id, request.auth.uid)).data.joinedAt;
          allow create: if isGubMember(id) && gubActive(id)
            && request.resource.data.keys().hasOnly(['commentId','authorId','authorName','text','createdAt'])
            && request.resource.data.commentId == commentId
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName == get(gubMemberPath(id, request.auth.uid)).data.displayName
            && validText(request.resource.data.text, 1, 1000)
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.lastCommentId == commentId
            && getAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.comments
              == get(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.comments + 1;
          allow update, delete: if false;
        }

        match /likes/{uid} {
          allow read: if isGubMember(id) || gubDeletingOwner(id);
          allow create: if own(uid) && isGubMember(id) && gubActive(id)
            && request.resource.data.keys().hasOnly(['userId','createdAt'])
            && request.resource.data.userId == uid
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.likes
              == get(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.likes + 1;
          allow update: if false;
          allow delete: if own(uid) && isGubMember(id) && gubActive(id)
            && getAfter(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.likes
              == get(/databases/$(database)/documents/gubs/$(id)/posts/$(postId)).data.likes - 1;
        }
      }
      match /tasks/{taskId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id) && validTaskCreate(id, taskId);
        allow update: if validTaskCompletion(id) || validTaskSelfUnassignment(id)
          || validTaskAnonymization(id);
        allow delete: if validHardDeleteWithCooldown(id, resource.data.creatorId, 'task', taskId)
          || gubDeletingOwner(id);
      }
      match /events/{eventId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id) && validCalendarEventCreate(id, eventId);
        allow update: if isGubMember(id) && gubActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creatorId','creatorName'])
          && validIdentityAnonymization(resource.data.creatorId, resource.data.creatorName,
            request.resource.data.creatorId, request.resource.data.creatorName);
        allow delete: if (gubActive(id) && (resource.data.creatorId == request.auth.uid || isGubOwner(id)))
          || gubDeletingOwner(id);
      }
      match /organizedEvents/{eventId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id) && validOrganizedEventCreate(id, eventId);
        allow update: if validOrganizedCompletion(id)
          || validOrganizedEventAnonymization(id)
          || validOrganizedAssignmentsAnonymization(id);
        allow delete: if validHardDeleteWithCooldown(id, resource.data.createdBy, 'organizedEvent', eventId)
          || gubDeletingOwner(id);
      }
      match /proposals/{proposalId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id) && validProposalCreate(id, proposalId);
        allow update: if isGubMember(id) && gubActive(id)
          && (validVoteAggregate(id, proposalId)
            || validProposalResult()
            || validProposalEventFlag()
            || validSoftDelete(id, resource.data.creatorId, 'proposal', proposalId)
            || validProposalAnonymization(id));
        allow delete: if gubDeletingOwner(id);
      }
      match /proposals/{proposalId}/votes/{uid} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if own(uid) && isGubMember(id) && gubActive(id)
          && get(proposalPath(id, proposalId)).data.status == 'voting'
          && request.resource.data.keys().hasOnly(['uid','vote','votedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.vote in ['yes','no']
          && request.resource.data.votedAt is timestamp;
        allow delete: if gubDeletingOwner(id);
      }
      match /goals/{goalId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if isGubMember(id) && gubActive(id) && validGoalCreate(id, goalId);
        allow update: if gubActive(id)
          && (validGoalProgress(id)
            || validGoalMemberDepartureProgress(id, goalId)
            || validSoftDelete(id, resource.data.ownerId, 'sharedBudget', goalId)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['originUserId','sourceAuthorName'])
              && validIdentityAnonymization(resource.data.originUserId, resource.data.sourceAuthorName,
                request.resource.data.originUserId, request.resource.data.sourceAuthorName)));
        allow delete: if gubDeletingOwner(id);
      }
      match /goals/{goalId}/members/{uid} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create: if gubActive(id) && validGoalMemberCreate(id, goalId, uid);
        allow update: if gubActive(id)
          && (validOwnContribution(id, goalId, uid) || validOwnerConfirmation(id));
        allow delete: if (gubActive(id) && isGubOwner(id) && uid != request.auth.uid)
          || (gubActive(id) && own(uid) && resource.data.confirmed == false)
          || gubDeletingOwner(id);
      }
      match /notifications/{notificationId} {
        allow read: if gubDeletingOwner(id);
        allow read: if isGubMember(id)
          && resource.data.createdAt >= get(gubMemberPath(id, request.auth.uid)).data.joinedAt;
        allow create: if isGubMember(id) && gubActive(id)
          && validNotificationCreate(id, notificationId);
        allow update: if isGubMember(id) && gubActive(id)
          && ((resource.data.createdAt is timestamp
              && get(gubMemberPath(id, request.auth.uid)).data.joinedAt is timestamp
              && resource.data.createdAt >= get(gubMemberPath(id, request.auth.uid)).data.joinedAt
              && validReadByUpdate())
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderId','senderName'])
              && validIdentityAnonymization(resource.data.senderId, resource.data.senderName,
                request.resource.data.senderId, request.resource.data.senderName))
            || validNotificationIdentityAnonymization(id)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && validOwnNotificationReadRemoval()));
        allow delete: if gubDeletingOwner(id);
      }
      match /creationCooldowns/{cooldownId} {
        allow read: if isGubMember(id) || gubDeletingOwner(id);
        allow create, update: if isGubMember(id) && gubActive(id)
          && validCooldownCause(id, cooldownId);
        allow delete: if gubDeletingOwner(id);
      }
    }

    match /communities/{id} {
      allow read: if signedIn() && (resource.data.visibility == 'public'
        || resource.data.ownerId == request.auth.uid || isCommunityMember(id));
      allow create: if linkedCommunityAccount() && validCommunityRootCreate(id)
        && validCommunityMemberAndCopy(id, request.auth.uid, 'owner')
        && getAfter(ownershipPath(request.auth.uid)).data.communityId == id
        && validCommunityRootSlugProjection(id);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'imageUrl','imagePublicId','imageVersion','imageUpdatedAt'
        ])
        ? validCommunityImageRootMutation(id)
        : (
          communityActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && (validCommunityMemberAndCopy(id, request.auth.uid, 'member')
            || validCommunityApprovalSignal(id, getAfter(communityMembershipMutationPath(id)).data.userId))
        || (communityActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && (isCommunityOwner(id)
            || (request.auth.uid != resource.data.ownerId
              && exists(communityMemberPath(id, request.auth.uid))
              && !existsAfter(communityMemberPath(id, request.auth.uid)))))
        || (isCommunityOwner(id) && resource.data.get('deletionStatus','active') == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionStatus','deletionStartedAt','deletionStartedBy','deletionRequestedBy'])
          && request.resource.data.deletionStatus == 'deleting'
          && request.resource.data.deletionStartedAt == request.time
          && request.resource.data.deletionStartedBy == request.auth.uid
          && request.resource.data.deletionRequestedBy == request.auth.uid)
        || (communityDeletingOwner(id) && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.deletionStatus == 'deleting'
          && request.resource.data.get('deletionRequestedBy','') == resource.data.get('deletionRequestedBy','')
          && request.resource.data.get('deletionStartedBy','') == resource.data.get('deletionStartedBy','')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionMembersCapturedAt'])
          && request.resource.data.deletionMembersCapturedAt == request.time)
        );
      allow delete: if communityFinalizingDeletion(id);
      match /members/{uid} {
        allow get: if communityExists(id)
          && ((linkedCommunityAccount() && own(uid))
            || isCommunityMember(id) || isCommunityOwner(id));
        allow list: if communityExists(id)
          && (isCommunityMember(id) || isCommunityOwner(id));
        allow create: if (linkedCommunityAccount() && own(uid)
          && communityAfter(id).data.get('deletionStatus','active') != 'deleting'
          && request.resource.data.role == (communityAfter(id).data.ownerId == uid ? 'owner' : 'member')
          && validCommunityMemberAndCopy(id,uid,request.resource.data.role))
          || (validCommunityApprovalSignal(id, uid)
            && validCommunityApprovalMember(id, uid));
        allow update: if (linkedCommunityAccount() && own(uid) && communityActive(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && validText(request.resource.data.displayName, 1, 25)
            && request.resource.data.displayName
              == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName)
          || validCommunityRewardMemberUpdate(id, uid)
          || validCommunityAskCooldownMemberUpdate(id, uid);
        allow delete: if communityDeletingOwner(id)
          || (isCommunityOwner(id) && uid != request.auth.uid
            && communityActive(id)
            && communityProjectionAbsent(id, uid)
            && communityAfter(id).data.memberCount == communityDoc(id).data.memberCount - 1)
          || (linkedCommunityAccount() && own(uid) && uid != communityDoc(id).data.ownerId
            && communityActive(id)
            && communityProjectionAbsent(id, uid)
            && communityAfter(id).data.memberCount == communityDoc(id).data.memberCount - 1);
      }
      match /bans/{uid} {
        allow get: if communityExists(id)
          && (isCommunityOwner(id) || (linkedCommunityAccount() && own(uid)));
        allow list: if communityExists(id) && isCommunityOwner(id);
        allow create: if isCommunityOwner(id) && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['userId','displayName','photoUrl','bannedBy','bannedAt'])
          && request.resource.data.userId == uid
          && validText(request.resource.data.displayName, 1, 25)
          && validNullableString(request.resource.data.photoUrl)
          && request.resource.data.bannedBy == request.auth.uid
          && request.resource.data.bannedAt == request.time
          && communityProjectionAbsent(id, uid)
          && !existsAfter(communityMemberPath(id, uid));
        allow delete: if isCommunityOwner(id);
      }
      match /messages/{messageId} {
        allow read: if communityDeletingOwner(id);
        allow read: if isCommunityMember(id)
          && resource.data.createdAt >= get(/databases/$(database)/documents/communities/$(id)/members/$(request.auth.uid)).data.joinedAt;
        allow create: if isCommunityMember(id) && communityActive(id)
          && communityChatAllowed(request.auth.uid)
          && request.resource.data.keys().hasOnly(['messageId','communityId','senderId','senderName','text','createdAt'])
          && request.resource.data.messageId == messageId
          && request.resource.data.communityId == id
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == get(communityMemberPath(id, request.auth.uid)).data.displayName
          && validText(request.resource.data.senderName, 1, 25)
          && validText(request.resource.data.text, 1, 2000)
          && request.resource.data.createdAt == request.time;
        allow update: if isCommunityMember(id) && communityActive(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderId','senderName'])
          && validIdentityAnonymization(resource.data.senderId, resource.data.senderName,
            request.resource.data.senderId, request.resource.data.senderName);
        allow delete: if communityDeletingOwner(id);
      }
      match /asks/{askId} {
        allow get: if isCommunityMember(id) && communityActive(id)
          && (!exists(/databases/$(database)/documents/communities/$(id)/asks/$(askId))
            || resource.data.status in ['active','resolved']);
        allow list: if communityDeletingOwner(id)
          || (isCommunityMember(id) && communityActive(id)
            && resource.data.status in ['active','resolved']);
        allow create: if isCommunityMember(id) && communityActive(id)
          && !exists(communityActiveAskSlotPath(id, request.auth.uid))
          && validCommunityActiveAskSlot(id, askId, request.auth.uid)
          && validCommunityAskCooldown(id, askId, request.auth.uid)
          && request.resource.data.keys().hasOnly([
            'askId','communityId','authorId','authorDisplayName','type',
            'sourceMessageId','text','createdAt','status'
          ])
          && askId == request.resource.data.askId
          && request.resource.data.communityId == id
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.type in ['help','information','advice']
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && validText(request.resource.data.authorDisplayName, 1, 25)
          && validText(request.resource.data.text, 1, 2000)
          && (
            (request.resource.data.keys().hasAny(['sourceMessageId'])
              && request.resource.data.sourceMessageId is string
              && askId == request.resource.data.sourceMessageId
              && exists(/databases/$(database)/documents/communities/$(id)/messages/$(askId))
              && get(/databases/$(database)/documents/communities/$(id)/messages/$(askId)).data.senderId == request.auth.uid
              && get(/databases/$(database)/documents/communities/$(id)/messages/$(askId)).data.createdAt
                >= get(communityMemberPath(id, request.auth.uid)).data.joinedAt
              && request.resource.data.authorDisplayName
                == get(/databases/$(database)/documents/communities/$(id)/messages/$(askId)).data.senderName
              && request.resource.data.text
                == get(/databases/$(database)/documents/communities/$(id)/messages/$(askId)).data.text)
            || (!request.resource.data.keys().hasAny(['sourceMessageId'])
              && exists(/databases/$(database)/documents/users/$(request.auth.uid))
              && request.resource.data.authorDisplayName
                == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName)
          );
        allow update: if validCommunityAskResolution(id, askId)
          || validCommunityAskAuthorEdit(id);
        allow delete: if communityDeletingOwner(id)
          || (isCommunityMember(id) && communityActive(id)
            && resource.data.authorId == request.auth.uid
            && (resource.data.status != 'active'
              || !existsAfter(communityActiveAskSlotPath(id, request.auth.uid))));
        match /answers/{answerId} {
          allow read: if communityDeletingOwner(id)
            || (isCommunityMember(id) && communityActive(id)
              && get(communityAskPath(id, askId)).data.status in ['active','resolved']);
          allow create: if isCommunityMember(id) && communityActive(id)
            && get(communityAskPath(id, askId)).data.status == 'active'
            && request.auth.uid != get(communityAskPath(id, askId)).data.authorId
            && request.resource.data.keys().hasOnly([
              'answerId','authorId','authorDisplayName','text','createdAt'
            ])
            && request.resource.data.answerId == answerId
            && answerId == request.auth.uid
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorDisplayName
              == get(communityMemberPath(id, request.auth.uid)).data.displayName
            && validText(request.resource.data.authorDisplayName, 1, 25)
            && validText(request.resource.data.text, 1, 2000)
            && request.resource.data.createdAt == request.time;
          allow update: if isCommunityMember(id) && communityActive(id)
            && get(communityAskPath(id, askId)).data.status == 'active'
            && resource.data.answerId == answerId
            && answerId == request.auth.uid
            && resource.data.authorId == request.auth.uid
            && resource.data.get('updatedAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt'])
            && validText(request.resource.data.text, 1, 2000)
            && request.resource.data.updatedAt == request.time;
          allow delete: if communityDeletingOwner(id)
            || (isCommunityMember(id) && communityActive(id)
              && (resource.data.authorId == request.auth.uid
                || get(communityAskPath(id, askId)).data.authorId == request.auth.uid)
              && !(get(communityAskPath(id, askId)).data.status == 'resolved'
                && get(communityAskPath(id, askId)).data.get('bestAnswerId', '') == answerId));
        }
      }
      match /activeAskSlots/{uid} {
        allow get: if communityDeletingOwner(id)
          || (isCommunityMember(id) && communityActive(id) && uid == request.auth.uid);
        allow list: if communityDeletingOwner(id);
        allow create: if isCommunityMember(id) && communityActive(id)
          && uid == request.auth.uid
          && !exists(communityActiveAskSlotPath(id, uid))
          && validCommunityActiveAskSlot(id, request.resource.data.askId, uid);
        allow update: if false;
        allow delete: if communityDeletingOwner(id)
          || (isCommunityMember(id) && communityActive(id)
            && uid == request.auth.uid
            && resource.data.authorId == request.auth.uid
            && (!existsAfter(communityAskPath(id, resource.data.askId))
              || getAfter(communityAskPath(id, resource.data.askId)).data.status == 'resolved'));
      }
      match /deletionMembers/{uid} {
        allow read: if communityDeletingOwner(id);
        allow create, update: if communityDeletingOwner(id)
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == uid;
        allow delete: if communityDeletingOwner(id);
      }
      match /joinRequests/{uid} {
        allow get: if communityExists(id)
          && ((linkedCommunityAccount() && own(uid)) || isCommunityOwner(id));
        allow list: if communityExists(id) && isCommunityOwner(id);
        allow create: if linkedCommunityAccount() && own(uid)
          && communityActive(id)
          && communityJoiningAllowed(id)
          && communityDoc(id).data.get('accessMode','approval') == 'approval'
          && !exists(communityMemberPath(id, uid))
          && !exists(communityBanPath(id, uid))
          && request.resource.data.keys().hasOnly(['userId','displayName','status','createdAt'])
          && request.resource.data.userId == uid
          && validText(request.resource.data.displayName, 1, 25)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if (validCommunityApprovalSignal(id, uid)
            && validCommunityApprovalRequest(id, uid))
          || (isCommunityOwner(id)
            && resource.data.status == 'pending'
            && request.resource.data.keys().hasOnly([
              'userId','displayName','status','createdAt','resolvedAt','resolvedBy'
            ])
            && request.resource.data.userId == uid
            && request.resource.data.displayName == resource.data.displayName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == 'rejected'
            && request.resource.data.resolvedAt == request.time
            && request.resource.data.resolvedBy == request.auth.uid)
          || (linkedCommunityAccount() && own(uid)
            && communityActive(id)
            && communityJoiningAllowed(id)
            && resource.data.status in ['rejected', 'approved']
            && !exists(communityMemberPath(id, uid))
            && !exists(communityBanPath(id, uid))
            && request.resource.data.keys().hasOnly([
              'userId','displayName','status','createdAt'
            ])
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.displayName == resource.data.displayName
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == 'pending');
        allow delete: if (linkedCommunityAccount() && own(uid)
          && resource.data.status == 'pending')
          || communityDeletingOwner(id);
      }
      match /membershipMutations/{mutationId} {
        allow create, update: if mutationId == 'current'
          && validCommunityApprovalMutation(id, request.resource.data.userId);
        allow read, delete: if communityDeletingOwner(id);
      }
    }

    match /{path=**}/asks/{askId} {
      allow list: if linkedCommunityAccount()
        && resource.data.communityId is string
        && isCommunityMember(resource.data.communityId)
        && communityActive(resource.data.communityId)
        && resource.data.status in ['active', 'resolved'];
    }

    match /communitySlugs/{slug} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if linkedCommunityAccount() && !exists(communitySlugPath(slug))
        && validCommunitySlugRegistryCreate(slug);
      allow update: if false;
      allow delete: if communityFinalizingDeletion(resource.data.communityId)
        && resource.data.slug == slug;
    }
    match /communityNames/{nameKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if linkedCommunityAccount() && !exists(communityNamePath(nameKey))
        && validCommunityNameRegistryCreate(nameKey);
      allow update: if false;
      allow delete: if communityFinalizingDeletion(resource.data.communityId)
        && resource.data.nameKey == nameKey;
    }
    match /communityPublic/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if linkedCommunityAccount() && validCommunityPublicCreate(slug);
      allow update: if validCommunityImagePublicMutation(slug);
      allow delete: if communityFinalizingDeletion(resource.data.communityId)
        && resource.data.slug == slug;
    }
    match /communityOwnership/{uid} {
      allow read: if linkedCommunityAccount() && own(uid);
      allow create: if linkedCommunityAccount() && own(uid) && request.resource.data.keys().hasOnly(['ownerId','communityId','createdAt'])
        && request.resource.data.ownerId == uid
        && request.resource.data.createdAt == request.time
        && communityAfter(request.resource.data.communityId).data.ownerId == uid
        && validCommunityMemberAndCopy(request.resource.data.communityId,uid,'owner');
      allow delete: if own(uid)
        && communityFinalizingDeletion(resource.data.communityId);
    }
    match /moderationReports/{reportId} {
      allow get: if signedIn()
        && reportId.matches('^.*__' + request.auth.uid + '$')
        && (!exists(moderationReportPath(reportId))
          || resource.data.reporterId == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && !exists(moderationReportPath(reportId))
        && validModerationReportCreate(reportId)
        && validModerationReportTargetLink(reportId);
      allow update, delete: if false;
    }
    match /moderationTargets/{targetKey} {
      allow get: if false;
      allow list: if false;
      allow create: if signedIn()
        && !exists(moderationTargetPath(targetKey))
        && validModerationTargetCreate(targetKey);
      allow update: if signedIn()
        && validModerationTargetUpdate(targetKey);
      allow delete: if false;
    }
    match /platformRestrictions/{uid} {
      allow get: if own(uid);
      allow list: if false;
      allow create: if validPlatformRestrictionInitialization(uid);
      allow update, delete: if false;
    }
    match /communityRestrictions/{communityId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validCommunityRestrictionInitialization(communityId);
      allow update: if false;
      allow delete: if communityFinalizingDeletion(communityId);
    }
  }
}
