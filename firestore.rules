rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function linkedCommunityAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validText(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength
        && value.matches('.*\\S.*');
    }
    function validCommunityName(value) {
      return validText(value, 3, 30)
        && value.matches('^[^\\n\\r]*$');
    }

    function gubPath(id) { return /databases/$(database)/documents/gubs/$(id); }
    function gubDoc(id) { return get(gubPath(id)); }
    function gubAfter(id) { return getAfter(gubPath(id)); }
    function gubMemberPath(id, uid) { return /databases/$(database)/documents/gubs/$(id)/members/$(uid); }
    function gubBanPath(id, uid) { return /databases/$(database)/documents/gubs/$(id)/bans/$(uid); }
    function userGubPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/gubs/$(id); }
    function inviteTokenPath(code) { return /databases/$(database)/documents/inviteTokens/$(code); }
    function isGubMember(id) { return signedIn() && exists(gubMemberPath(id, request.auth.uid)); }
    function isGubOwner(id) { return signedIn() && gubDoc(id).data.ownerId == request.auth.uid; }
    function gubActive(id) { return gubDoc(id).data.get('deletionStatus', 'active') != 'deleting'; }
    function gubDeletingOwner(id) {
      return isGubOwner(id) && gubDoc(id).data.get('deletionStatus', '') == 'deleting'
        && gubDoc(id).data.get('deletionRequestedBy', '') == request.auth.uid;
    }
    function validGubDeletionPhaseAdvance(before, after) {
      return (before == 'preparing' && after in ['preparing','nestedCollections'])
        || (before == 'nestedCollections' && after in ['nestedCollections','directCollections'])
        || (before == 'directCollections' && after in ['directCollections','userCopies'])
        || (before == 'userCopies' && after in ['userCopies','finalizing'])
        || (before == 'finalizing' && after == 'finalizing');
    }
    function validUserProfile(data) {
      return data.keys().hasOnly([
          'displayName','displayNameChangedAt','createdAt','updatedAt','activeHub','avatar','photoUrl','photoURL'
        ])
        && data.displayName is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['displayNameChangedAt'])
          || data.displayNameChangedAt is timestamp)
        && (data.get('activeHub', null) == null || data.activeHub is string)
        && (data.get('avatar', null) == null || data.avatar is string)
        && (data.get('photoUrl', null) == null || data.photoUrl is string)
        && (data.get('photoURL', null) == null || data.photoURL is string);
    }
    function validGubRootCreate(id) {
      let data = request.resource.data;
      let token = getAfter(inviteTokenPath(data.inviteTokenId));
      return data.keys().hasOnly([
          'gubId','name','ownerId','inviteTokenId','memberCount','createdAt'
        ])
        && data.gubId == id
        && data.name is string
        && data.ownerId == request.auth.uid
        && validInviteTokenCode(data.inviteTokenId)
        && data.memberCount == 1
        && data.createdAt is timestamp
        && token.data.gubId == id
        && token.data.ownerId == data.ownerId
        && token.data.gubName == data.name
        && token.data.active == true;
    }
    function validInviteTokenCode(code) {
      return code is string
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$');
    }
    function validGubMemberData(data, uid, role) {
      return data.keys().hasOnly([
          'uid','displayName','photoUrl','role','joinedAt',
          'antiSpamRulesAccepted','antiSpamRulesAcceptedAt','antiSpamRulesVersion',
          'joinedViaInviteToken'
        ])
        && data.uid == uid
        && data.displayName is string
        && (data.get('photoUrl', null) == null || data.photoUrl is string)
        && data.role == role
        && data.joinedAt is timestamp
        && ((role == 'owner' && !data.keys().hasAny(['joinedViaInviteToken']))
          || (role == 'member' && validInviteTokenCode(data.joinedViaInviteToken)));
    }
    function validCommunityMemberData(data, uid, role) {
      return data.keys().hasOnly([
          'uid','displayName','photoUrl','role','joinedAt',
          'antiSpamRulesAccepted','antiSpamRulesAcceptedAt','antiSpamRulesVersion'
        ])
        && data.uid == uid
        && validText(data.displayName, 1, 25)
        && (data.get('photoUrl', null) == null || data.photoUrl is string)
        && data.role == role
        && data.joinedAt is timestamp;
    }
    function validGubCopyData(data, id, role) {
      let root = gubAfter(id).data;
      return data.keys().hasOnly([
          'gubId','name','ownerId','role','joinedAt'
        ])
        && data.gubId == id
        && data.name == root.name
        && data.ownerId == root.ownerId
        && data.role == role
        && data.joinedAt is timestamp;
    }
    function validGubCopyRoleBackfill(data, id, uid) {
      return data.keys().hasOnly([
          'gubId','name','ownerId','role','joinedAt','inviteCode','memberCount'
        ])
        && data.gubId == id
        && data.ownerId == gubAfter(id).data.ownerId
        && data.role == (gubAfter(id).data.ownerId == uid ? 'owner' : 'member');
    }
    function validGubJoin(id, uid) {
      let member = getAfter(gubMemberPath(id, uid)).data;
      let root = gubDoc(id).data;
      let token = get(inviteTokenPath(member.joinedViaInviteToken)).data;
      return exists(gubPath(id))
        && !exists(gubMemberPath(id, uid))
        && !exists(gubBanPath(id, uid))
        && gubActive(id)
        && gubAfter(id).data.diff(gubDoc(id).data).affectedKeys().hasOnly(['memberCount'])
        && gubAfter(id).data.memberCount == gubDoc(id).data.memberCount + 1
        && member.joinedViaInviteToken == root.inviteTokenId
        && token.gubId == id
        && token.ownerId == root.ownerId
        && token.gubName == root.name
        && token.active == true;
    }
    function gubOwnerRemovingMember(id, uid) {
      return isGubOwner(id) && uid != request.auth.uid
        && exists(gubMemberPath(id, uid))
        && !existsAfter(gubMemberPath(id, uid));
    }
    function validGubOwnerMember(id, uid) {
      let member = getAfter(gubMemberPath(id, uid));
      return validGubMemberData(member.data, uid, 'owner');
    }
    function validGubMemberAndCopy(id, uid, role) {
      let member = getAfter(gubMemberPath(id, uid));
      let copy = getAfter(userGubPath(uid, id));
      let root = gubAfter(id);
      return validGubMemberData(member.data, uid, role)
        && validGubCopyData(copy.data, id, role)
        && (role == 'owner' || validGubJoin(id, uid));
    }

    function validInviteTokenCreate(code) {
      let data = request.resource.data;
      let root = getAfter(gubPath(data.gubId)).data;
      return signedIn()
        && validInviteTokenCode(code)
        && data.keys().hasOnly(['gubId','ownerId','gubName','active','createdAt'])
        && data.gubId is string
        && data.ownerId == request.auth.uid
        && data.gubName is string
        && data.active == true
        && data.createdAt == request.time
        && root.gubId == data.gubId
        && root.ownerId == data.ownerId
        && root.name == data.gubName
        && root.inviteTokenId == code;
    }
    function validInviteTokenRevocation(code) {
      let data = resource.data;
      let root = gubDoc(data.gubId).data;
      let afterRoot = gubAfter(data.gubId).data;
      return signedIn()
        && data.ownerId == request.auth.uid
        && root.ownerId == request.auth.uid
        && root.inviteTokenId == code
        && data.gubName == root.name
        && request.resource.data.diff(data).affectedKeys().hasOnly(['active'])
        && data.active == true
        && request.resource.data.active == false
        && afterRoot.deletionStatus == 'deleting'
        && afterRoot.deletionRequestedBy == request.auth.uid;
    }
    function validInviteRegeneration(id) {
      let root = gubDoc(id).data;
      let afterRoot = gubAfter(id).data;
      let oldCode = root.inviteTokenId;
      let newCode = afterRoot.inviteTokenId;
      return isGubOwner(id) && gubActive(id)
        && afterRoot.diff(root).affectedKeys().hasOnly(['inviteTokenId','inviteRegeneratedAt'])
        && validInviteTokenCode(newCode) && newCode != oldCode
        && afterRoot.inviteRegeneratedAt == request.time
        && (!root.keys().hasAny(['inviteRegeneratedAt'])
          || request.time >= root.inviteRegeneratedAt + duration.value(60, 's'))
        && existsAfter(inviteTokenPath(newCode));
    }
    function validInviteTokenRegeneration(code) {
      let data = resource.data;
      return signedIn() && data.ownerId == request.auth.uid && data.active == true
        && request.resource.data.diff(data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false
        && validInviteRegeneration(data.gubId);
    }
    function inviteTokenRevokedAfter(id, code) {
      return !existsAfter(inviteTokenPath(code))
        || (getAfter(inviteTokenPath(code)).data.gubId == id
          && getAfter(inviteTokenPath(code)).data.active == false);
    }

    function messagePath(id, messageId) { return /databases/$(database)/documents/gubs/$(id)/messages/$(messageId); }
    function taskPath(id, taskId) { return /databases/$(database)/documents/gubs/$(id)/tasks/$(taskId); }
    function eventPath(id, eventId) { return /databases/$(database)/documents/gubs/$(id)/events/$(eventId); }
    function organizedEventPath(id, eventId) { return /databases/$(database)/documents/gubs/$(id)/organizedEvents/$(eventId); }
    function proposalPath(id, proposalId) { return /databases/$(database)/documents/gubs/$(id)/proposals/$(proposalId); }
    function votePath(id, proposalId, uid) { return /databases/$(database)/documents/gubs/$(id)/proposals/$(proposalId)/votes/$(uid); }
    function goalPath(id, goalId) { return /databases/$(database)/documents/gubs/$(id)/goals/$(goalId); }
    function goalMemberPath(id, goalId, uid) { return /databases/$(database)/documents/gubs/$(id)/goals/$(goalId)/members/$(uid); }
    function cooldownPath(id, cooldownId) { return /databases/$(database)/documents/gubs/$(id)/creationCooldowns/$(cooldownId); }

    function validNullableString(value) { return value == null || value is string; }
    function validNullableTimestamp(value) { return value == null || value is timestamp; }
    function deletedUserId() { return '__deleted_user__'; }
    function deletedUserName() { return 'Deleted user'; }
    function validIdentityAnonymization(beforeId, beforeName, afterId, afterName) {
      return beforeId == request.auth.uid
        && afterId == deletedUserId()
        && afterName == deletedUserName();
    }
    function validIdAnonymization(beforeId, afterId) {
      return beforeId == request.auth.uid && afterId == deletedUserId();
    }
    function validTaskAnonymization(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isGubMember(id) && gubActive(id)
        && changed.hasOnly(['creatorId','creatorName','assignedUserId','assignedUserName',
          'originUserId','sourceAuthorName','completedBy'])
        && changed.hasAny(['creatorId','assignedUserId','originUserId','completedBy'])
        && (!changed.hasAny(['creatorId','creatorName'])
          || validIdentityAnonymization(resource.data.creatorId, resource.data.creatorName,
            request.resource.data.creatorId, request.resource.data.creatorName))
        && (!changed.hasAny(['assignedUserId','assignedUserName'])
          || validIdentityAnonymization(resource.data.assignedUserId, resource.data.assignedUserName,
            request.resource.data.assignedUserId, request.resource.data.assignedUserName))
        && (!changed.hasAny(['originUserId','sourceAuthorName'])
          || validIdentityAnonymization(resource.data.originUserId, resource.data.sourceAuthorName,
            request.resource.data.originUserId, request.resource.data.sourceAuthorName))
        && (!changed.hasAny(['completedBy'])
          || validIdAnonymization(resource.data.completedBy, request.resource.data.completedBy));
    }
    function validOrganizedEventAnonymization(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isGubMember(id) && gubActive(id)
        && changed.hasOnly(['createdBy','createdByName','originUserId','sourceAuthorName'])
        && changed.hasAny(['createdBy','originUserId'])
        && (!changed.hasAny(['createdBy','createdByName'])
          || validIdentityAnonymization(resource.data.createdBy, resource.data.createdByName,
            request.resource.data.createdBy, request.resource.data.createdByName))
        && (!changed.hasAny(['originUserId','sourceAuthorName'])
          || validIdentityAnonymization(resource.data.originUserId, resource.data.sourceAuthorName,
            request.resource.data.originUserId, request.resource.data.sourceAuthorName));
    }
    function validOrganizedAssignmentIdentityAnonymization(before, after) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['userId','userName'])
        && changed.hasAny(['userId'])
        && before.userId == request.auth.uid
        && after.userId == deletedUserId()
        && after.userName == deletedUserName();
    }
    function validOrganizedAssignmentAnonymizationAt(index) {
      return resource.data.assignments.size() <= index
        || request.resource.data.assignments[index] == resource.data.assignments[index]
        || validOrganizedAssignmentIdentityAnonymization(
          resource.data.assignments[index], request.resource.data.assignments[index]);
    }
    function validOrganizedAssignmentsAnonymization(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isGubMember(id) && gubActive(id)
        && changed.hasOnly(['assignments'])
        && changed.hasAny(['assignments'])
        && resource.data.assignments is list
        && request.resource.data.assignments is list
        && request.resource.data.assignments.size() == resource.data.assignments.size()
        && request.resource.data.assignments.size() <= 20
        && validOrganizedAssignmentAnonymizationAt(0)
        && validOrganizedAssignmentAnonymizationAt(1)
        && validOrganizedAssignmentAnonymizationAt(2)
        && validOrganizedAssignmentAnonymizationAt(3)
        && validOrganizedAssignmentAnonymizationAt(4)
        && validOrganizedAssignmentAnonymizationAt(5)
        && validOrganizedAssignmentAnonymizationAt(6)
        && validOrganizedAssignmentAnonymizationAt(7)
        && validOrganizedAssignmentAnonymizationAt(8)
        && validOrganizedAssignmentAnonymizationAt(9)
        && validOrganizedAssignmentAnonymizationAt(10)
        && validOrganizedAssignmentAnonymizationAt(11)
        && validOrganizedAssignmentAnonymizationAt(12)
        && validOrganizedAssignmentAnonymizationAt(13)
        && validOrganizedAssignmentAnonymizationAt(14)
        && validOrganizedAssignmentAnonymizationAt(15)
        && validOrganizedAssignmentAnonymizationAt(16)
        && validOrganizedAssignmentAnonymizationAt(17)
        && validOrganizedAssignmentAnonymizationAt(18)
        && validOrganizedAssignmentAnonymizationAt(19);
    }
    function validProposalAnonymization(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isGubMember(id) && gubActive(id)
        && changed.hasOnly(['creatorId','creatorName','originUserId','sourceAuthorName'])
        && changed.hasAny(['creatorId','originUserId'])
        && (!changed.hasAny(['creatorId','creatorName'])
          || validIdentityAnonymization(resource.data.creatorId, resource.data.creatorName,
            request.resource.data.creatorId, request.resource.data.creatorName))
        && (!changed.hasAny(['originUserId','sourceAuthorName'])
          || validIdentityAnonymization(resource.data.originUserId, resource.data.sourceAuthorName,
            request.resource.data.originUserId, request.resource.data.sourceAuthorName));
    }
    function validChatSource(data, id) {
      let message = get(messagePath(id, data.sourceId)).data;
      return data.sourceType == 'chat'
        && data.sourceId is string
        && message.gubId == id
        && data.sourcePreview == message.text
        && data.originUserId == message.senderId
        && data.sourceAuthorName == message.senderName;
    }
    function validSource(data, id) {
      return (data.sourceType == 'manual'
          && data.sourceId == null
          && data.sourcePreview == null
          && data.originUserId == null
          && data.sourceAuthorName == null)
        || validChatSource(data, id);
    }
    function validAssignee(id, data) {
      return (data.assignedUserId == null && data.assignedUserName == null)
        || (data.assignedUserId is string
          && exists(gubMemberPath(id, data.assignedUserId))
          && data.assignedUserName == get(gubMemberPath(id, data.assignedUserId)).data.displayName);
    }
    function validTaskCreate(id, taskId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'gubId','taskId','title','description','creatorId','creatorName',
          'assignedUserId','assignedUserName','sourceType','sourceId','sourcePreview',
          'originUserId','sourceAuthorName','additionalDetails','status','priority',
          'createdAt','dueDate','completedAt','completedBy','notificationsEnabled','archived'
        ])
        && data.gubId == id && data.taskId == taskId
        && data.title is string && data.description is string
        && data.creatorId == request.auth.uid
        && data.creatorName == get(gubMemberPath(id, request.auth.uid)).data.displayName
        && validAssignee(id, data)
        && validSource(data, id)
        && (data.sourceType == 'chat' ? validNullableString(data.additionalDetails) : data.additionalDetails == null)
        && data.status == 'active' && data.priority == 'normal'
        && data.createdAt is timestamp && validNullableTimestamp(data.dueDate)
        && data.completedAt == null && data.completedBy == null
        && data.notificationsEnabled is bool && data.archived == false;
    }
    function validTaskCompletion(id) {
      return isGubMember(id) && gubActive(id)
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt','completedBy'])
        && request.resource.data.status == 'completed'
        && request.resource.data.completedAt is timestamp
        && request.resource.data.completedBy == request.auth.uid
        && (resource.data.assignedUserId == null
          || resource.data.assignedUserId == ''
          || resource.data.assignedUserId == request.auth.uid);
    }
    function validTaskSelfUnassignment(id) {
      return isGubMember(id) && gubActive(id)
        && resource.data.status == 'active'
        && resource.data.assignedUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'assignedUserId','assignedUserName'
        ])
        && request.resource.data.assignedUserId == null
        && request.resource.data.assignedUserName == null;
    }

    function validCalendarEventCreate(id, eventId) {
      let data = request.resource.data;
      let proposal = get(proposalPath(id, data.proposalId)).data;
      return data.keys().hasOnly([
          'gubId','eventId','proposalId','title','description','type',
          'creatorId','creatorName','eventDate','createdAt','status'
        ])
        && data.gubId == id && data.eventId == eventId
        && data.proposalId is string
        && proposal.status == 'approved' && proposal.resultProcessed == true
        && proposal.eventCreated == false
        && data.title == proposal.title && data.description == proposal.description
        && data.type == proposal.type && data.creatorId == proposal.creatorId
        && data.creatorName == proposal.creatorName && data.eventDate == proposal.eventDate
        && data.createdAt is timestamp && data.status == 'scheduled';
    }

    function validOrganizedEventCreate(id, eventId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'eventId','gubId','title','description','location','scheduledAt','createdBy',
          'createdByName','createdAt','status','completedAt','sourceType','sourceId',
          'sourcePreview','originUserId','sourceAuthorName','assignments'
        ])
        && data.eventId == eventId && data.gubId == id
        && data.title is string && validNullableString(data.description)
        && validNullableString(data.location) && validNullableTimestamp(data.scheduledAt)
        && data.createdBy == request.auth.uid
        && validNullableString(data.createdByName)
        && data.createdAt is timestamp && data.status == 'active' && data.completedAt == null
        && validSource(data, id)
        && data.assignments is list && data.assignments.size() > 0;
    }
    function changedOwnAssignmentAt(data, index) {
      return data.assignments.size() > index
        && resource.data.assignments[index].userId == request.auth.uid
        && data.assignments[index].keys().hasOnly(['userId','userName','taskText','isCompleted','completedAt'])
        && data.assignments[index].diff(resource.data.assignments[index]).affectedKeys().hasOnly(['isCompleted','completedAt'])
        && data.assignments[index].diff(resource.data.assignments[index]).affectedKeys().hasAny(['isCompleted'])
        && data.assignments[index].isCompleted is bool
        && ((data.assignments[index].isCompleted == true && data.assignments[index].completedAt is timestamp)
          || (data.assignments[index].isCompleted == false && data.assignments[index].completedAt == null));
    }
    function changesOwnOrganizedAssignment(data) {
      return changedOwnAssignmentAt(data,0) || changedOwnAssignmentAt(data,1)
        || changedOwnAssignmentAt(data,2) || changedOwnAssignmentAt(data,3)
        || changedOwnAssignmentAt(data,4) || changedOwnAssignmentAt(data,5)
        || changedOwnAssignmentAt(data,6) || changedOwnAssignmentAt(data,7)
        || changedOwnAssignmentAt(data,8) || changedOwnAssignmentAt(data,9)
        || changedOwnAssignmentAt(data,10) || changedOwnAssignmentAt(data,11)
        || changedOwnAssignmentAt(data,12) || changedOwnAssignmentAt(data,13)
        || changedOwnAssignmentAt(data,14) || changedOwnAssignmentAt(data,15)
        || changedOwnAssignmentAt(data,16) || changedOwnAssignmentAt(data,17)
        || changedOwnAssignmentAt(data,18) || changedOwnAssignmentAt(data,19);
    }
    function validOrganizedCompletion(id) {
      return isGubMember(id) && gubActive(id) && resource.data.status == 'active'
        && changesOwnOrganizedAssignment(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignments','status','completedAt'])
        && request.resource.data.assignments is list
        && request.resource.data.assignments.size() == resource.data.assignments.size()
        && request.resource.data.assignments.toSet().difference(resource.data.assignments.toSet()).size() <= 1
        && resource.data.assignments.toSet().difference(request.resource.data.assignments.toSet()).size() <= 1
        && (request.resource.data.status == 'active' || request.resource.data.status == 'completed')
        && validNullableTimestamp(request.resource.data.completedAt);
    }

    function validProposalCreate(id, proposalId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'gubId','proposalId','title','description','creatorId','creatorName','status',
          'createdAt','expiresAt','eventDate','type','yesVotes','noVotes','memberCount',
          'resultProcessed','eventCreated','tasksCreated','sourceType','sourceId',
          'sourcePreview','originUserId','sourceAuthorName'
        ])
        && data.gubId == id && data.proposalId == proposalId
        && data.title is string && data.description is string
        && data.creatorId == request.auth.uid
        && data.creatorName == get(gubMemberPath(id, request.auth.uid)).data.displayName
        && data.status == 'voting' && data.createdAt is timestamp && data.expiresAt is timestamp
        && validNullableTimestamp(data.eventDate) && data.type is string
        && data.yesVotes == 0 && data.noVotes == 0
        && data.memberCount == gubDoc(id).data.memberCount
        && data.resultProcessed == false && data.eventCreated == false && data.tasksCreated == false
        && validSource(data, id);
    }
    function validVoteAggregate(id, proposalId) {
      let vote = get(votePath(id, proposalId, request.auth.uid)).data.vote;
      return resource.data.status == 'voting' && resource.data.resultProcessed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yesVotes','noVotes'])
        && request.resource.data.yesVotes >= 0 && request.resource.data.noVotes >= 0
        && request.resource.data.yesVotes + request.resource.data.noVotes <= resource.data.memberCount
        && ((vote == 'yes'
            && request.resource.data.yesVotes == resource.data.yesVotes + 1
            && request.resource.data.noVotes == resource.data.noVotes)
          || (vote == 'no'
            && request.resource.data.noVotes == resource.data.noVotes + 1
            && request.resource.data.yesVotes == resource.data.yesVotes));
    }
    function validProposalResult() {
      let data = request.resource.data;
      let remaining = data.memberCount - data.yesVotes - data.noVotes;
      return resource.data.status == 'voting' && resource.data.resultProcessed == false
        && data.diff(resource.data).affectedKeys().hasOnly(['status','resultProcessed'])
        && data.resultProcessed == true
        && ((data.status == 'approved' && data.yesVotes > data.noVotes + remaining)
          || (data.status == 'rejected' && data.noVotes >= data.yesVotes + remaining));
    }
    function validProposalEventFlag() {
      return resource.data.status == 'approved' && resource.data.resultProcessed == true
        && resource.data.eventCreated == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventCreated'])
        && request.resource.data.eventCreated == true;
    }

    function validGoalCreate(id, goalId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'goalId','title','description','targetAmount','currentAmount','ownerId',
          'completedMembers','totalMembers','status','archived','createdAt','deadline',
          'completedAt','sourceType','sourceId','sourcePreview','originUserId','sourceAuthorName'
        ])
        && data.goalId == goalId && data.title is string && data.description is string
        && data.targetAmount is number && data.targetAmount > 0
        && data.currentAmount == 0 && data.ownerId == request.auth.uid && isGubOwner(id)
        && data.completedMembers == 0 && data.totalMembers == gubDoc(id).data.memberCount
        && data.status == 'active' && data.archived == false
        && data.createdAt is timestamp && validNullableTimestamp(data.deadline)
        && data.completedAt == null && validSource(data, id);
    }
    function validGoalMemberCreate(id, goalId, memberId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid','displayName','photoUrl','amount','confirmed','updatedAt','confirmedAt'])
        && data.uid == memberId && exists(gubMemberPath(id, memberId))
        && data.displayName == get(gubMemberPath(id, memberId)).data.displayName
        && validNullableString(data.photoUrl) && data.amount == 0
        && data.confirmed == false && data.updatedAt is timestamp && data.confirmedAt == null
        && get(goalPath(id, goalId)).data.ownerId == request.auth.uid;
    }
    function validOwnContribution(id, goalId, memberId) {
      let goal = get(goalPath(id, goalId)).data;
      return own(memberId) && goal.status == 'active' && goal.archived == false
        && resource.data.confirmed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount','confirmed','updatedAt','confirmedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount <= goal.targetAmount - goal.currentAmount
        && request.resource.data.confirmed == false
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.confirmedAt == null;
    }
    function validOwnerConfirmation(id) {
      return isGubOwner(id)
        && resource.data.confirmed == false && resource.data.amount > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmed','confirmedAt'])
        && request.resource.data.confirmed == true
        && request.resource.data.confirmedAt is timestamp;
    }
    function validGoalProgress(id) {
      return isGubOwner(id) && resource.data.status == 'active' && resource.data.archived == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentAmount','completedMembers','totalMembers','status','archived','completedAt'
        ])
        && request.resource.data.currentAmount is number
        && (
          (
            request.resource.data.currentAmount > resource.data.currentAmount
            && request.resource.data.completedMembers == resource.data.completedMembers + 1
            && request.resource.data.totalMembers == resource.data.totalMembers
          )
          || (
            request.resource.data.totalMembers < resource.data.totalMembers
            && request.resource.data.currentAmount <= resource.data.currentAmount
            && request.resource.data.completedMembers <= resource.data.completedMembers
          )
        )
        && request.resource.data.currentAmount <= resource.data.targetAmount
        && request.resource.data.totalMembers >= 0
        && ((request.resource.data.status == 'active' && request.resource.data.completedAt == null)
          || (request.resource.data.status == 'completed'
            && request.resource.data.currentAmount == resource.data.targetAmount
            && request.resource.data.completedAt is timestamp));
    }
    function validGoalMemberDepartureProgress(id, goalId) {
      return signedIn() && isGubMember(id) && gubActive(id)
        && resource.data.status == 'active' && resource.data.archived == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'currentAmount','completedMembers','totalMembers'
        ])
        && request.resource.data.currentAmount == resource.data.currentAmount
        && request.resource.data.completedMembers == resource.data.completedMembers
        && request.resource.data.totalMembers == resource.data.totalMembers - 1
        && request.resource.data.totalMembers >= 0
        && !exists(goalMemberPath(id, goalId, request.auth.uid));
    }

    function validSoftDelete(id, creatorId, moduleType, itemId) {
      return gubActive(id) && (request.auth.uid == creatorId || isGubOwner(id))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','archived','deletedAt','deletedBy'])
        && request.resource.data.status == 'deleted'
        && request.resource.data.get('archived', false) == (moduleType == 'sharedBudget')
        && request.resource.data.deletedAt is timestamp
        && request.resource.data.deletedBy == request.auth.uid
        && (creatorId == gubDoc(id).data.ownerId
          || getAfter(cooldownPath(id, creatorId + '_' + moduleType)).data.deletedItemId == itemId);
    }
    function validCooldownData(id, cooldownId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['creatorId','moduleType','deletedItemId','deletedBy','deletedAt','availableAt'])
        && cooldownId == data.creatorId + '_' + data.moduleType
        && data.moduleType in ['task','organizedEvent','proposal','sharedBudget']
        && data.creatorId is string && data.deletedItemId is string
        && data.deletedBy == request.auth.uid
        && data.deletedAt is timestamp && data.availableAt is timestamp;
    }
    function validCooldownCause(id, cooldownId) {
      let data = request.resource.data;
      return validCooldownData(id, cooldownId)
        && ((data.moduleType == 'task'
            && get(taskPath(id, data.deletedItemId)).data.creatorId == data.creatorId
            && !existsAfter(taskPath(id, data.deletedItemId)))
          || (data.moduleType == 'organizedEvent'
            && get(organizedEventPath(id, data.deletedItemId)).data.createdBy == data.creatorId
            && !existsAfter(organizedEventPath(id, data.deletedItemId)))
          || (data.moduleType == 'proposal'
            && get(proposalPath(id, data.deletedItemId)).data.creatorId == data.creatorId
            && getAfter(proposalPath(id, data.deletedItemId)).data.status == 'deleted')
          || (data.moduleType == 'sharedBudget'
            && get(goalPath(id, data.deletedItemId)).data.ownerId == data.creatorId
            && getAfter(goalPath(id, data.deletedItemId)).data.status == 'deleted'));
    }
    function validHardDeleteWithCooldown(id, creatorId, moduleType, itemId) {
      return gubActive(id) && (request.auth.uid == creatorId || isGubOwner(id))
        && (creatorId == gubDoc(id).data.ownerId
          || getAfter(cooldownPath(id, creatorId + '_' + moduleType)).data.deletedItemId == itemId);
    }

    function validNotificationCreate(id, notificationId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['notificationId','title','body','type','senderId','senderName','createdAt','readBy','data'])
        && data.notificationId == notificationId
        && data.title is string && data.body is string
        && data.type in [
          'task_created','task_completed','proposal_created','proposal_approved','proposal_rejected',
          'organized_event_created','organized_event_completed','goal_created','goal_submitted',
          'goal_confirmation','board_post'
        ]
        && data.senderId is string && data.senderName is string
        && data.createdAt is timestamp && data.readBy is list && data.data is map
        && ((data.type == 'task_created'
              && get(taskPath(id, data.data.taskId)).data.creatorId == data.senderId
              && data.senderId == request.auth.uid)
          || (data.type == 'task_completed'
              && get(taskPath(id, data.data.taskId)).data.completedBy == data.senderId
              && data.senderId == request.auth.uid)
          || (data.type == 'proposal_created'
              && get(proposalPath(id, data.data.proposalId)).data.creatorId == data.senderId
              && data.senderId == request.auth.uid)
          || ((data.type == 'proposal_approved' || data.type == 'proposal_rejected')
              && get(proposalPath(id, data.data.proposalId)).data.creatorId == data.senderId
              && get(proposalPath(id, data.data.proposalId)).data.resultProcessed == true)
          || (data.type == 'organized_event_created'
              && get(organizedEventPath(id, data.data.eventId)).data.createdBy == data.senderId
              && data.senderId == request.auth.uid)
          || (data.type == 'organized_event_completed'
              && get(organizedEventPath(id, data.data.eventId)).data.status == 'completed'
              && data.senderId == request.auth.uid)
          || (data.type == 'goal_created'
              && get(goalPath(id, data.data.goalId)).data.ownerId == data.senderId
              && data.senderId == request.auth.uid)
          || (data.type == 'goal_submitted'
              && get(goalMemberPath(id, data.data.goalId, data.data.memberId)).data.uid == data.senderId
              && data.senderId == request.auth.uid)
          || (data.type == 'goal_confirmation'
              && isGubOwner(id) && data.senderId == request.auth.uid
              && get(goalMemberPath(id, data.data.goalId, data.data.memberId)).data.confirmed == true)
          || (data.type == 'board_post' && data.senderId == request.auth.uid
              && data.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName));
    }
    function validReadByUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && resource.data.readBy.toSet().difference(request.resource.data.readBy.toSet()).size() == 0
        && request.resource.data.readBy.toSet().difference(resource.data.readBy.toSet()).hasOnly([request.auth.uid]);
    }
    function validOwnNotificationReadRemoval() {
      return resource.data.readBy is list
        && request.resource.data.readBy is list
        && resource.data.readBy.toSet().hasAny([request.auth.uid])
        && request.resource.data.readBy.toSet()
          == resource.data.readBy.toSet().difference([request.auth.uid].toSet())
        && request.resource.data.readBy.size() == request.resource.data.readBy.toSet().size();
    }
    function validDeletedNotificationBody(id) {
      let data = request.resource.data;
      return (data.type == 'task_created'
          && data.body == 'Deleted user assigned a new task: '
            + get(taskPath(id, data.data.taskId)).data.title)
        || (data.type == 'proposal_created'
          && data.body == 'Deleted user created a new proposal.')
        || (data.type == 'organized_event_created'
          && data.body == 'Deleted user assigned you a task for '
            + get(organizedEventPath(id, data.data.eventId)).data.title + '.')
        || (data.type == 'goal_created'
          && data.body == 'Deleted user created “'
            + get(goalPath(id, data.data.goalId)).data.title + '”.')
        || (data.type == 'goal_confirmation'
          && data.body == 'Deleted user confirmed a contribution.')
        || (data.type == 'board_post'
          && data.body == 'Deleted user published a new post.');
    }
    function validNotificationIdentityAnonymization(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isGubMember(id) && gubActive(id)
        && changed.hasOnly(['senderId','senderName','body','readBy'])
        && changed.hasAny(['senderId'])
        && validIdentityAnonymization(resource.data.senderId, resource.data.senderName,
          request.resource.data.senderId, request.resource.data.senderName)
        && (!changed.hasAny(['body']) || validDeletedNotificationBody(id))
        && (!changed.hasAny(['readBy']) || validOwnNotificationReadRemoval());
    }

    function communityPath(id) { return /databases/$(database)/documents/communities/$(id); }
    function communityDoc(id) { return get(communityPath(id)); }
    function communityAfter(id) { return getAfter(communityPath(id)); }
    function communityMemberPath(id, uid) { return /databases/$(database)/documents/communities/$(id)/members/$(uid); }
    function communityAskPath(id, askId) { return /databases/$(database)/documents/communities/$(id)/asks/$(askId); }
    function communityAnswerPath(id, askId, answerId) { return /databases/$(database)/documents/communities/$(id)/asks/$(askId)/answers/$(answerId); }
    function communityActiveAskSlotPath(id, uid) { return /databases/$(database)/documents/communities/$(id)/activeAskSlots/$(uid); }
    function communityUserProgressPath(uid) { return /databases/$(database)/documents/communityUserProgress/$(uid); }
    function communityDeletionMemberPath(id, uid) { return /databases/$(database)/documents/communities/$(id)/deletionMembers/$(uid); }
    function communityBanPath(id, uid) { return /databases/$(database)/documents/communities/$(id)/bans/$(uid); }
    function userCommunityPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/communities/$(id); }
    function communityJoinRequestPath(id, uid) { return /databases/$(database)/documents/communities/$(id)/joinRequests/$(uid); }
    function moderationReportPath(reportId) { return /databases/$(database)/documents/moderationReports/$(reportId); }
    function moderationTargetPath(targetKey) { return /databases/$(database)/documents/moderationTargets/$(targetKey); }
    function platformRestrictionPath(uid) { return /databases/$(database)/documents/platformRestrictions/$(uid); }
    function communityRestrictionPath(id) { return /databases/$(database)/documents/communityRestrictions/$(id); }
    function communityMembershipMutationPath(id) { return /databases/$(database)/documents/communities/$(id)/membershipMutations/current; }
    function ownershipPath(uid) { return /databases/$(database)/documents/communityOwnership/$(uid); }
    function communitySlugPath(slug) { return /databases/$(database)/documents/communitySlugs/$(slug); }
    function communityPublicPath(slug) { return /databases/$(database)/documents/communityPublic/$(slug); }
    function communityNamePath(nameKey) { return /databases/$(database)/documents/communityNames/$(nameKey); }
    function validCommunitySlug(slug) {
      return slug is string && slug.size() >= 1 && slug.size() <= 60
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }
    function validCommunityNameKey(nameKey) {
      return nameKey is string && nameKey.size() >= 1 && nameKey.size() <= 60;
    }
    // V2 Community name key: trim, lowercase, normalize the same common
    // accents as CommunityNameKey in Dart, remove all whitespace, then escape
    // slash for the Firestore document ID. Punctuation otherwise remains part
    // of the key.
    function canonicalCommunityNameKey(name) {
      return name.trim().lower()
        .replace('à', 'a').replace('á', 'a').replace('â', 'a').replace('ã', 'a').replace('ä', 'a').replace('å', 'a')
        .replace('æ', 'ae').replace('ç', 'c').replace('è', 'e').replace('é', 'e').replace('ê', 'e').replace('ë', 'e')
        .replace('ì', 'i').replace('í', 'i').replace('î', 'i').replace('ï', 'i').replace('ñ', 'n')
        .replace('ò', 'o').replace('ó', 'o').replace('ô', 'o').replace('õ', 'o').replace('ö', 'o').replace('ø', 'o').replace('œ', 'oe')
        .replace('ß', 'ss').replace('ù', 'u').replace('ú', 'u').replace('û', 'u').replace('ü', 'u').replace('ý', 'y').replace('ÿ', 'y')
        .replace('\\s+', '').replace('[\\r\\n]', '')
        .replace('/', '∕');
    }
    function communityOwnerRemovingMember(id, uid) {
      return isCommunityOwner(id) && uid != request.auth.uid
        && exists(communityMemberPath(id, uid))
        && !existsAfter(communityMemberPath(id, uid));
    }
    function communityExists(id) { return exists(communityPath(id)); }
    function isCommunityMember(id) {
      return linkedCommunityAccount() && communityExists(id)
        && exists(communityMemberPath(id, request.auth.uid));
    }
    function isCommunityOwner(id) {
      return linkedCommunityAccount() && communityExists(id)
        && communityDoc(id).data.ownerId == request.auth.uid;
    }
    function communityActive(id) {
      return communityExists(id)
        && communityDoc(id).data.get('deletionStatus', 'active') != 'deleting';
    }
    function validCommunityRewardMemberUpdate(id, uid) {
      let afterMember = request.resource.data;
      let progress = getAfter(communityUserProgressPath(uid)).data;
      let askId = progress.get('lastRewardAskId', '');
      let askBefore = get(communityAskPath(id, askId)).data;
      let askAfter = getAfter(communityAskPath(id, askId)).data;
      let oldBest = resource.data.get('bestAnswerCount', 0);
      return isCommunityMember(id) && communityActive(id)
        && askId is string && askId.size() > 0
        && progress.lastRewardCommunityId == id
        && progress.lastRewardRole == 'bestAnswer'
        && askBefore.status == 'active'
        && askBefore.authorId == request.auth.uid
        && askAfter.status == 'resolved'
        && askAfter.xpAwarded == true
        && afterMember.diff(resource.data).affectedKeys().hasOnly(['bestAnswerCount'])
        && uid == askAfter.bestAnswerAuthorId
        && uid != askAfter.authorId
        && afterMember.bestAnswerCount == oldBest + 1;
    }
    function validCommunityProgressReward(uid) {
      let afterProgress = request.resource.data;
      let id = afterProgress.get('lastRewardCommunityId', '');
      let askId = afterProgress.get('lastRewardAskId', '');
      let role = afterProgress.get('lastRewardRole', '');
      let askBefore = get(communityAskPath(id, askId)).data;
      let askAfter = getAfter(communityAskPath(id, askId)).data;
      let oldXp = exists(communityUserProgressPath(uid))
        ? get(communityUserProgressPath(uid)).data.get('xp', 0)
        : 0;
      return linkedCommunityAccount()
        && afterProgress.keys().hasOnly([
          'xp','updatedAt','lastRewardCommunityId','lastRewardAskId','lastRewardRole',
          'communityIds','membershipProjectionCommunityId',
          'membershipProjectionAction','membershipProjectionUpdatedAt',
          'communityProjectionVersion'
        ])
        && afterProgress.xp is int
        && afterProgress.xp >= 0
        && afterProgress.updatedAt == request.time
        && id is string && id.size() > 0
        && askId is string && askId.size() > 0
        && exists(communityMemberPath(id, uid))
        && afterProgress.get('communityIds', []).toSet().hasAny([id])
        && afterProgress.get('communityIds', []).toSet()
          == (exists(communityUserProgressPath(uid))
            ? get(communityUserProgressPath(uid)).data.get('communityIds', []).toSet()
            : [].toSet()).union([id].toSet())
        && askBefore.status == 'active'
        && askBefore.authorId == request.auth.uid
        && askAfter.status == 'resolved'
        && askAfter.xpAwarded == true
        && ((role == 'bestAnswer'
            && uid == askAfter.bestAnswerAuthorId
            && uid != askAfter.authorId
            && afterProgress.xp == oldXp + 20)
          || (role == 'askAuthor'
            && uid == askAfter.authorId
            && afterProgress.xp == oldXp + 2));
    }
    function validCommunityProgressSchema(data) {
      return data.keys().hasOnly([
          'xp','updatedAt','lastRewardCommunityId','lastRewardAskId','lastRewardRole',
          'communityIds','membershipProjectionCommunityId',
          'membershipProjectionAction','membershipProjectionUpdatedAt',
          'communityProjectionVersion'
        ])
        && data.xp is int && data.xp >= 0
        && data.get('communityIds', []) is list;
    }
    function validCommunityProjectionJoin(uid) {
      let after = request.resource.data;
      let id = after.get('membershipProjectionCommunityId', '');
      let beforeIds = exists(communityUserProgressPath(uid))
        ? resource.data.get('communityIds', []).toSet()
        : [].toSet();
      let afterIds = after.get('communityIds', []).toSet();
      return linkedCommunityAccount()
        && validCommunityProgressSchema(after)
        && id is string && id.size() > 0
        && after.membershipProjectionAction in ['join','backfill']
        && after.membershipProjectionUpdatedAt == request.time
        && afterIds == beforeIds.union([id].toSet())
        && existsAfter(communityMemberPath(id, uid))
        && getAfter(communityMemberPath(id, uid)).data.uid == uid
        && (own(uid) || validCommunityApprovalSignal(id, uid))
        && (!exists(communityUserProgressPath(uid)) || after.xp == resource.data.xp);
    }
    function validCommunityProjectionRemoval(uid) {
      let after = request.resource.data;
      let id = after.get('membershipProjectionCommunityId', '');
      let beforeIds = resource.data.get('communityIds', []).toSet();
      let afterIds = after.get('communityIds', []).toSet();
      let deletionCleanup = after.membershipProjectionAction == 'delete'
        && communityDeletingOwner(id)
        && exists(communityDeletionMemberPath(id, uid))
        && !existsAfter(communityDeletionMemberPath(id, uid))
        && !existsAfter(userCommunityPath(uid, id));
      return linkedCommunityAccount()
        && validCommunityProgressSchema(after)
        && id is string && id.size() > 0
        && after.membershipProjectionAction in ['leave','ban','delete']
        && after.membershipProjectionUpdatedAt == request.time
        && beforeIds.hasAny([id])
        && afterIds == beforeIds.difference([id].toSet())
        && after.xp == resource.data.xp
        && ((request.auth.uid == uid || isCommunityOwner(id))
          && !existsAfter(communityMemberPath(id, uid))
          || deletionCleanup);
    }
    function validCommunityProjectionVersion(uid) {
      let after = request.resource.data;
      return linkedCommunityAccount() && own(uid)
        && validCommunityProgressSchema(after)
        && after.communityProjectionVersion == 1
        && ((!exists(communityUserProgressPath(uid))
            && after.xp == 0
            && after.get('communityIds', []).size() == 0)
          || (exists(communityUserProgressPath(uid))
            && after.diff(resource.data).affectedKeys()
              .hasOnly(['communityProjectionVersion'])));
    }
    function communityProjectionContains(id, uid) {
      return existsAfter(communityUserProgressPath(uid))
        && getAfter(communityUserProgressPath(uid)).data
          .get('communityIds', []).toSet().hasAny([id]);
    }
    function communityProjectionAbsent(id, uid) {
      return !existsAfter(communityUserProgressPath(uid))
        || !getAfter(communityUserProgressPath(uid)).data
          .get('communityIds', []).toSet().hasAny([id]);
    }
    function validCommunityAskResolution(id, askId) {
      let afterAsk = request.resource.data;
      let answer = get(communityAnswerPath(id, askId, afterAsk.bestAnswerId)).data;
      let winnerBefore = get(communityMemberPath(id, afterAsk.bestAnswerAuthorId)).data;
      let winnerAfter = getAfter(communityMemberPath(id, afterAsk.bestAnswerAuthorId)).data;
      let winnerProgress = getAfter(communityUserProgressPath(afterAsk.bestAnswerAuthorId)).data;
      let askerProgress = getAfter(communityUserProgressPath(resource.data.authorId)).data;
      return isCommunityMember(id) && communityActive(id)
        && resource.data.status == 'active'
        && resource.data.authorId == request.auth.uid
        && afterAsk.diff(resource.data).affectedKeys().hasOnly([
          'status','bestAnswerId','bestAnswerAuthorId','resolvedAt','xpAwarded'
        ])
        && afterAsk.status == 'resolved'
        && afterAsk.bestAnswerId is string
        && afterAsk.bestAnswerAuthorId == answer.authorId
        && answer.authorId != resource.data.authorId
        && afterAsk.resolvedAt == request.time
        && afterAsk.xpAwarded == true
        && !existsAfter(communityActiveAskSlotPath(id, resource.data.authorId))
        && winnerAfter.bestAnswerCount == winnerBefore.get('bestAnswerCount', 0) + 1
        && winnerProgress.lastRewardCommunityId == id
        && winnerProgress.lastRewardAskId == askId
        && winnerProgress.lastRewardRole == 'bestAnswer'
        && askerProgress.lastRewardCommunityId == id
        && askerProgress.lastRewardAskId == askId
        && askerProgress.lastRewardRole == 'askAuthor';
    }
    function validCommunityAskAuthorEdit(id) {
      let afterAsk = request.resource.data;
      return isCommunityMember(id) && communityActive(id)
        && resource.data.status == 'active'
        && resource.data.authorId == request.auth.uid
        && afterAsk.status == 'active'
        && afterAsk.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt'])
        && validText(afterAsk.text, 1, 2000)
        && afterAsk.updatedAt == request.time;
    }
    function validCommunityActiveAskSlot(id, askId, uid) {
      let slot = getAfter(communityActiveAskSlotPath(id, uid)).data;
      let ask = getAfter(communityAskPath(id, askId)).data;
      return existsAfter(communityActiveAskSlotPath(id, uid))
        && slot.keys().hasOnly(['askId','authorId','createdAt'])
        && slot.askId == askId
        && slot.authorId == uid
        && slot.createdAt == request.time
        && ask.askId == askId
        && ask.authorId == uid
        && ask.status == 'active';
    }
    function validCommunityAskCooldown(id, askId, uid) {
      let beforeMember = get(communityMemberPath(id, uid)).data;
      let afterMember = getAfter(communityMemberPath(id, uid)).data;
      return existsAfter(communityMemberPath(id, uid))
        && afterMember.diff(beforeMember).affectedKeys().hasOnly([
          'lastAskCreatedAt'
        ])
        && afterMember.lastAskCreatedAt == request.time
        && (!beforeMember.keys().hasAny(['lastAskCreatedAt'])
          || request.time >= beforeMember.lastAskCreatedAt + duration.value(8, 'h'))
        && validCommunityActiveAskSlot(id, askId, uid);
    }
    function validCommunityAskCooldownMemberUpdate(id, uid) {
      let afterSlot = getAfter(communityActiveAskSlotPath(id, uid)).data;
      let afterAsk = getAfter(communityAskPath(id, afterSlot.askId)).data;
      let beforeMember = resource.data;
      let afterMember = request.resource.data;
      return isCommunityMember(id) && communityActive(id)
        && existsAfter(communityActiveAskSlotPath(id, uid))
        && existsAfter(communityAskPath(id, afterSlot.askId))
        && afterSlot.authorId == uid
        && afterSlot.createdAt == request.time
        && afterAsk.askId == afterSlot.askId
        && afterAsk.authorId == uid
